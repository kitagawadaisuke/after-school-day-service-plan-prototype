{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Ephemeral Michi-note initial-tenant onboarding task. It has a dedicated DB role, Cognito create/read only, and must be deleted after the controlled one-off run.",
  "Parameters": {
    "ContainerImage": { "Type": "String", "Description": "The same reviewed immutable application image digest used by the web service." },
    "TaskCpuArchitecture": { "Type": "String", "Default": "ARM64", "AllowedValues": ["ARM64", "X86_64"] },
    "VpcId": { "Type": "AWS::EC2::VPC::Id" },
    "VpcCidr": { "Type": "String", "AllowedPattern": "^(10|172\\.(1[6-9]|2[0-9]|3[0-1])|192\\.168)\\.[0-9]{1,3}\\.[0-9]{1,3}/(1[6-9]|2[0-8])$" },
    "DatabaseSecurityGroupId": { "Type": "AWS::EC2::SecurityGroup::Id" },
    "DatabaseHost": { "Type": "String", "MinLength": 1 },
    "DatabasePort": { "Type": "Number", "Default": 5432, "MinValue": 1, "MaxValue": 65535 },
    "DatabaseName": { "Type": "String", "Default": "michinote", "AllowedPattern": "^[a-z][a-z0-9_]{0,62}$" },
    "DatabaseProvisionerSecretArn": { "Type": "String", "AllowedPattern": "^arn:[^:]+:secretsmanager:[^:]+:[0-9]{12}:secret:.+$" },
    "OnboardingRequestSecretArn": { "Type": "String", "AllowedPattern": "^arn:[^:]+:secretsmanager:[^:]+:[0-9]{12}:secret:.+$", "Description": "Short-lived JSON secret containing stable IDs and the initial tenant/facility/admin request. Delete after evidence capture." },
    "DataKeyArn": { "Type": "String", "AllowedPattern": "^arn:[^:]+:kms:[^:]+:[0-9]{12}:key/.+$" },
    "CognitoUserPoolId": { "Type": "String", "MinLength": 1 },
    "CognitoUserPoolArn": { "Type": "String", "AllowedPattern": "^arn:[^:]+:cognito-idp:[^:]+:[0-9]{12}:userpool/.+$" },
    "ApplicationLogGroupName": { "Type": "String", "MinLength": 1 }
  },
  "Resources": {
    "OnboardingSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Ephemeral initial-tenant task; Cognito HTTPS and PostgreSQL only",
        "SecurityGroupEgress": [
          { "IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0", "Description": "Cognito and required AWS APIs through NAT" },
          { "IpProtocol": "tcp", "FromPort": { "Ref": "DatabasePort" }, "ToPort": { "Ref": "DatabasePort" }, "DestinationSecurityGroupId": { "Ref": "DatabaseSecurityGroupId" }, "Description": "PostgreSQL TLS" },
          { "IpProtocol": "udp", "FromPort": 53, "ToPort": 53, "CidrIp": { "Ref": "VpcCidr" }, "Description": "VPC DNS" },
          { "IpProtocol": "tcp", "FromPort": 53, "ToPort": 53, "CidrIp": { "Ref": "VpcCidr" }, "Description": "VPC DNS fallback" }
        ],
        "VpcId": { "Ref": "VpcId" }
      }
    },
    "DatabaseFromOnboardingIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": { "Ref": "DatabaseSecurityGroupId" },
        "IpProtocol": "tcp",
        "FromPort": { "Ref": "DatabasePort" },
        "ToPort": { "Ref": "DatabasePort" },
        "SourceSecurityGroupId": { "Ref": "OnboardingSecurityGroup" },
        "Description": "Ephemeral initial-tenant onboarding task"
      }
    },
    "OnboardingTaskExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "ecs-tasks.amazonaws.com" }, "Action": "sts:AssumeRole" }] },
        "ManagedPolicyArns": [{ "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy" }],
        "Policies": [{
          "PolicyName": "ReadOnboardingSecretsOnce",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              { "Effect": "Allow", "Action": "secretsmanager:GetSecretValue", "Resource": [{ "Ref": "DatabaseProvisionerSecretArn" }, { "Ref": "OnboardingRequestSecretArn" }] },
              { "Effect": "Allow", "Action": "kms:Decrypt", "Resource": { "Ref": "DataKeyArn" } }
            ]
          }
        }]
      }
    },
    "OnboardingTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "ecs-tasks.amazonaws.com" }, "Action": "sts:AssumeRole" }] },
        "Policies": [{
          "PolicyName": "ReconcileInitialAdministratorOnly",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [{
              "Effect": "Allow",
              "Action": ["cognito-idp:AdminCreateUser", "cognito-idp:AdminGetUser"],
              "Resource": { "Ref": "CognitoUserPoolArn" }
            }]
          }
        }]
      }
    },
    "OnboardingTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "ContainerDefinitions": [{
          "Name": "initial-tenant-onboarding",
          "Image": { "Ref": "ContainerImage" },
          "Command": ["node", "scripts/provision-tenant.mjs"],
          "Essential": true,
          "ReadonlyRootFilesystem": true,
          "LinuxParameters": { "InitProcessEnabled": true },
          "Environment": [
            { "Name": "NODE_ENV", "Value": "production" },
            { "Name": "AWS_REGION", "Value": { "Ref": "AWS::Region" } },
            { "Name": "COGNITO_USER_POOL_ID", "Value": { "Ref": "CognitoUserPoolId" } },
            { "Name": "PROVISION_DATABASE_HOST", "Value": { "Ref": "DatabaseHost" } },
            { "Name": "PROVISION_DATABASE_PORT", "Value": { "Fn::Sub": "${DatabasePort}" } },
            { "Name": "PROVISION_DATABASE_NAME", "Value": { "Ref": "DatabaseName" } },
            { "Name": "PROVISION_DATABASE_SSL", "Value": "require" },
            { "Name": "PROVISION_DATABASE_CA_FILE", "Value": "/opt/michinote/certs/aws-rds-ap-northeast-3-bundle.pem" }
          ],
          "Secrets": [
            { "Name": "PROVISION_DATABASE_USER", "ValueFrom": { "Fn::Join": ["", [{ "Ref": "DatabaseProvisionerSecretArn" }, ":username::"]] } },
            { "Name": "PROVISION_DATABASE_PASSWORD", "ValueFrom": { "Fn::Join": ["", [{ "Ref": "DatabaseProvisionerSecretArn" }, ":password::"]] } },
            { "Name": "ONBOARDING_OPERATION_ID", "ValueFrom": { "Fn::Join": ["", [{ "Ref": "OnboardingRequestSecretArn" }, ":operationId::"]] } },
            { "Name": "ONBOARDING_ORGANIZATION_ID", "ValueFrom": { "Fn::Join": ["", [{ "Ref": "OnboardingRequestSecretArn" }, ":organizationId::"]] } },
            { "Name": "ONBOARDING_ORGANIZATION_NAME", "ValueFrom": { "Fn::Join": ["", [{ "Ref": "OnboardingRequestSecretArn" }, ":organizationName::"]] } },
            { "Name": "ONBOARDING_ADMIN_USER_ID", "ValueFrom": { "Fn::Join": ["", [{ "Ref": "OnboardingRequestSecretArn" }, ":administratorUserId::"]] } },
            { "Name": "ONBOARDING_ADMIN_EMAIL", "ValueFrom": { "Fn::Join": ["", [{ "Ref": "OnboardingRequestSecretArn" }, ":administratorEmail::"]] } },
            { "Name": "ONBOARDING_ADMIN_DISPLAY_NAME", "ValueFrom": { "Fn::Join": ["", [{ "Ref": "OnboardingRequestSecretArn" }, ":administratorDisplayName::"]] } },
            { "Name": "ONBOARDING_ADMIN_MEMBERSHIP_ID", "ValueFrom": { "Fn::Join": ["", [{ "Ref": "OnboardingRequestSecretArn" }, ":administratorMembershipId::"]] } },
            { "Name": "ONBOARDING_FACILITY_ID", "ValueFrom": { "Fn::Join": ["", [{ "Ref": "OnboardingRequestSecretArn" }, ":firstFacilityId::"]] } },
            { "Name": "ONBOARDING_FACILITY_CODE", "ValueFrom": { "Fn::Join": ["", [{ "Ref": "OnboardingRequestSecretArn" }, ":firstFacilityCode::"]] } },
            { "Name": "ONBOARDING_FACILITY_NAME", "ValueFrom": { "Fn::Join": ["", [{ "Ref": "OnboardingRequestSecretArn" }, ":firstFacilityName::"]] } },
            { "Name": "ONBOARDING_RESEND_INVITATION", "ValueFrom": { "Fn::Join": ["", [{ "Ref": "OnboardingRequestSecretArn" }, ":resendInvitation::"]] } },
            { "Name": "ONBOARDING_RESEND_EVENT_ID", "ValueFrom": { "Fn::Join": ["", [{ "Ref": "OnboardingRequestSecretArn" }, ":resendEventId::"]] } }
          ],
          "LogConfiguration": {
            "LogDriver": "awslogs",
            "Options": {
              "awslogs-group": { "Ref": "ApplicationLogGroupName" },
              "awslogs-region": { "Ref": "AWS::Region" },
              "awslogs-stream-prefix": "initial-tenant-onboarding"
            }
          }
        }],
        "Cpu": "256",
        "Memory": "512",
        "ExecutionRoleArn": { "Fn::GetAtt": ["OnboardingTaskExecutionRole", "Arn"] },
        "Family": { "Fn::Sub": "${AWS::StackName}-initial-tenant" },
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "RuntimePlatform": { "CpuArchitecture": { "Ref": "TaskCpuArchitecture" }, "OperatingSystemFamily": "LINUX" },
        "TaskRoleArn": { "Fn::GetAtt": ["OnboardingTaskRole", "Arn"] }
      }
    }
  },
  "Outputs": {
    "OnboardingTaskDefinitionArn": { "Value": { "Ref": "OnboardingTaskDefinition" } },
    "OnboardingSecurityGroupId": { "Value": { "Ref": "OnboardingSecurityGroup" } }
  }
}
