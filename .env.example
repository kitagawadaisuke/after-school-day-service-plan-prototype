NODE_ENV=development
HOST=127.0.0.1
PORT=8015
APP_BASE_URL=http://127.0.0.1:8015

# Local/legacy connection form. Use this OR the separate AWS fields below.
DATABASE_URL=postgresql://michinote_app:change-me@127.0.0.1:5432/michinote

# Recommended for AWS ECS. DATABASE_PASSWORD is injected from Secrets Manager;
# the application does not concatenate these values into a URL.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
# Independent upload-attestation key. In AWS this comes from a different
# Secrets Manager secret than the runtime DB password and is also provided to
# the controlled migration task so PostgreSQL can verify, but never reveal, it.
PDF_FINALIZATION_SECRET=

# AWS RDS PostgreSQL production uses DATABASE_SSL=require.
DATABASE_SSL=disable
# Required with DATABASE_SSL=require. The production image contains this path.
DATABASE_CA_FILE=/opt/michinote/certs/aws-rds-ap-northeast-3-bundle.pem
DB_POOL_MAX=10

# Schema migration uses a separate owner-level credential. Set these only on a
# controlled one-off migration task; never inject them into the normal web task.
MIGRATION_DATABASE_HOST=
MIGRATION_DATABASE_PORT=5432
MIGRATION_DATABASE_NAME=
MIGRATION_DATABASE_USER=
MIGRATION_DATABASE_PASSWORD=
MIGRATION_DATABASE_SSL=require
# Generated runtime credential injected only into the one-off migration task.
# The migrator configures this exact PostgreSQL LOGIN after applying grants.
RUNTIME_DATABASE_USER=michinote_runtime
RUNTIME_DATABASE_PASSWORD=
# Dedicated initial-tenant role. The migration task configures its SCRAM LOGIN;
# only the short-lived onboarding task receives the resulting secret.
PROVISION_DATABASE_USER=michinote_provisioner
PROVISION_DATABASE_PASSWORD=
# Optional path to an RDS CA bundle. Required when the system trust store does
# not already trust the current AWS RDS CA.
MIGRATION_DATABASE_CA_FILE=/opt/michinote/certs/aws-rds-ap-northeast-3-bundle.pem

# Initial tenant onboarding (one-off task only). Put these values in a
# short-lived Secrets Manager JSON secret; do not pass them as task overrides.
PROVISION_DATABASE_HOST=
PROVISION_DATABASE_PORT=5432
PROVISION_DATABASE_NAME=michinote
PROVISION_DATABASE_SSL=require
PROVISION_DATABASE_CA_FILE=/opt/michinote/certs/aws-rds-ap-northeast-3-bundle.pem
ONBOARDING_OPERATION_ID=
ONBOARDING_ORGANIZATION_ID=
ONBOARDING_ORGANIZATION_NAME=
ONBOARDING_ADMIN_USER_ID=
ONBOARDING_ADMIN_EMAIL=
ONBOARDING_ADMIN_DISPLAY_NAME=
ONBOARDING_ADMIN_MEMBERSHIP_ID=
ONBOARDING_FACILITY_ID=
ONBOARDING_FACILITY_CODE=
ONBOARDING_FACILITY_NAME=
# Keep false for normal onboarding. Recovery requires the original operation
# and canonical values plus a newly approved, one-use resend event UUID.
ONBOARDING_RESEND_INVITATION=false
ONBOARDING_RESEND_EVENT_ID=

# development is forbidden when NODE_ENV=production.
AUTH_MODE=development
COOKIE_SECRET=replace-with-at-least-32-random-characters
AUDIT_HASH_KEY=replace-with-an-independent-32-character-key

# Required when AUTH_MODE=cognito.
AWS_REGION=ap-northeast-3
# KMS customer-managed key ARN. Required in production for encrypted fields and PDFs.
DOCUMENT_KMS_KEY_ARN=
# Private, versioned S3 bucket for immutable PDF snapshots. Required in production.
DOCUMENT_BUCKET=
# Optional when Chromium is not in Playwright's default browser location.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
PDF_RENDER_CONCURRENCY=1
PDF_RENDER_QUEUE_LIMIT=1
PDF_RENDER_RETRY_AFTER_SECONDS=5
PDF_JOB_LEASE_SECONDS=120
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Optional. Prefer a Cognito public client with PKCE; set only for a confidential client.
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
# Must exactly match APP_BASE_URL + /auth/callback and the Cognito app client.
COGNITO_CALLBACK_URL=
# Must exactly match the APP_BASE_URL root and the Cognito allowed sign-out URL.
COGNITO_LOGOUT_URL=
SESSION_TTL_HOURS=12

# Local, fictitious tenant context only.
DEV_USER_ID=018f1db5-c170-7c35-a784-3cfc6f98c201
DEV_TENANT_ID=018f1db5-c170-7c35-a784-3cfc6f98c101
DEV_FACILITY_ID=018f1db5-c170-7c35-a784-3cfc6f98c301
DEV_ROLE=tenant_admin
