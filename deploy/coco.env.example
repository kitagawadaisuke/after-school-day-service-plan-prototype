# COCO専用の設定です。Soleilなど他サービスの .env をコピーしないでください。
NODE_ENV=development
HOST=127.0.0.1
PORT=8020
APP_BASE_URL=https://st-coco.ai-labo.cloud
PUBLIC_SAAS_UI=true

# COCO専用のPostgreSQL接続情報を設定します。
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=disable

# 初期化時もCOCO専用DBアカウントだけを使用します。
MIGRATION_DATABASE_HOST=
MIGRATION_DATABASE_PORT=5432
MIGRATION_DATABASE_NAME=
MIGRATION_DATABASE_USER=coco_runtime
MIGRATION_DATABASE_PASSWORD=
MIGRATION_DATABASE_SSL=disable
RUNTIME_DATABASE_USER=coco_runtime
RUNTIME_DATABASE_PASSWORD=
PROVISION_DATABASE_HOST=
PROVISION_DATABASE_PORT=5432
PROVISION_DATABASE_NAME=
PROVISION_DATABASE_USER=coco_runtime
PROVISION_DATABASE_PASSWORD=
PROVISION_DATABASE_SSL=disable

# COCO専用のローカル認証設定を設定します。
AUTH_MODE=local
COOKIE_SECRET=
LOCAL_SIGNUP_TENANT_ID=
AUDIT_HASH_KEY=
PDF_FINALIZATION_SECRET=
