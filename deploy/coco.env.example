# COCO専用の設定です。Soleilなど他サービスの .env をコピーしないでください。
NODE_ENV=development
HOST=127.0.0.1
PORT=2020
APP_BASE_URL=https://st-coco.ai-labo.cloud
PUBLIC_SAAS_UI=true

# COCO専用のPostgreSQL接続情報を設定します。
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=disable

# COCO専用のローカル認証設定を設定します。
AUTH_MODE=local
COOKIE_SECRET=
LOCAL_SIGNUP_TENANT_ID=
AUDIT_HASH_KEY=
PDF_FINALIZATION_SECRET=
