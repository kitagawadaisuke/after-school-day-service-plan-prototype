[Unit]
Description=COCO after-school day service application
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/prod1/coco_app
EnvironmentFile=/home/prod1/coco_app/.env
Environment=HOST=127.0.0.1
Environment=PORT=2020
ExecStart=/usr/bin/node /home/prod1/coco_app/server/start.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
